# Vercel Production Deployment
# URL: https://vms-lilac.vercel.app/

# ====================================================================
# PHASE 3: ODOO ERP INTEGRATION & SYNCHRONIZATION CONFIGURATION
# ====================================================================
# Odoo Server base URL (e.g. https://erp.vms-industrie.com or http://localhost:8069)
ODOO_URL=https://erp.vms-industrie.com

# Target Odoo PostgreSQL Database name
ODOO_DB=vms_production

# Dedicated integration service user in Odoo (least-privilege account)
ODOO_USERNAME=quick_sync@vms.dz

# Odoo API Key (recommended) or user password
ODOO_API_KEY=vms_odoo_api_key_secret_token

# Odoo Target Version (14.0, 15.0, 16.0, 17.0, 18.0)
ODOO_VERSION=17.0

# Timeout in milliseconds for XML-RPC / JSON-RPC requests
ODOO_TIMEOUT_MS=10000

# Automated periodic background sync (true/false)
ODOO_AUTO_SYNC_ENABLED=false

# Sync interval in minutes when auto-sync is enabled
ODOO_SYNC_INTERVAL_MINUTES=60

# Sandbox simulation mode (true = isolated test mock, false = live ERP)
ODOO_SANDBOX_MODE=true
